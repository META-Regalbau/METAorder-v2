<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="Meta\CartSignal\Core\CartSignalSender">
            <argument type="service" id="http_client"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="Meta\CartSignal\Subscriber\CartSignalSubscriber">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="messenger.default_bus"/>
            <argument type="service" id="Meta\CartSignal\Core\CartSignalSender"/>
            <argument type="service" id="logger"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Meta\CartSignal\Core\Message\CartSignalMessageHandler">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Meta\CartSignal\Core\CartSignalSender"/>
            <!-- als Handler über #[AsMessageHandler] registriert (autoconfigure); ein zusätzlicher Tag würde ihn doppelt anmelden -->
        </service>
    </services>
</container>
