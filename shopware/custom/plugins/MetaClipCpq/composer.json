{
    "name": "meta/clip-cpq",
    "description": "Shopware 6.6/6.7 CPQ-Grundplugin fuer META CLIP.",
    "type": "shopware-platform-plugin",
    "license": "proprietary",
    "version": "1.1.0",
    "require": {
        "php": ">=8.2",
        "shopware/core": "~6.6.0 || ~6.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
