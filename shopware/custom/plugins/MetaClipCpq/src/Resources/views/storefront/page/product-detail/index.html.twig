{% sw_extends '@Storefront/storefront/page/product-detail/index.html.twig' %}

{#
    Verlinkt in den echten METAorder-CPQ-Konfigurator (React, mit 3D-Ansicht,
    Raumplanung, Preis-Wasserfall) statt eines eigenen, unvollständigen
    Vue-Widgets hier im Shop zu pflegen — siehe CpqHandoffTokenExtension.php
    für die Token-Signierung und client/src/pages/PublicCpqConfiguratorPage.tsx
    für die Gegenseite. Ohne Plugin-Konfiguration (Basis-URL/Mandanten-ID/
    Secret) bleibt der Link ausgeblendet, statt eine kaputte URL zu zeigen.
#}
{% block page_product_detail_buy_container %}
    {{ parent() }}

    {% set cpqToken = meta_clip_cpq_handoff_token(
        context.customer is not null ? context.customer.id : null,
        context.salesChannel.id,
        page.product.id
    ) %}
    {% set cpqConfiguratorUrl = meta_clip_cpq_configurator_url(cpqToken, context.salesChannel.id) %}

    {% if cpqConfiguratorUrl %}
        <div class="w-100 mt-3">
            <a href="{{ cpqConfiguratorUrl }}" class="btn btn-primary w-100" target="_blank" rel="noopener">
                {{ 'meta-clip-cpq.storefront.configureButton'|trans|sw_sanitize }}
            </a>
        </div>
    {% endif %}
{% endblock %}
