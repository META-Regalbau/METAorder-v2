{
  "name": "METAorder Händlerportal-Passwort → Outlook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "metaorder-portal-password",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-portal-password",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "metaorder-portal-password",
      "credentials": {
        "httpHeaderAuth": {
          "id": "METAORDER_PORTAL_PASSWORD_API_KEY_CREDENTIAL_ID",
          "name": "METAorder Portal-Passwort API-Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "is-test",
              "leftValue": "={{ $json.body.metadata && $json.body.metadata.test === true }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-test",
      "name": "Testnachricht?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, test: true } }}",
        "options": {}
      },
      "id": "respond-test",
      "name": "Antwort Test",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, -140]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toRecipients": "={{ $json.body.data.to }}",
        "subject": "={{ $json.body.data.subject }}",
        "bodyContent": "={{ $json.body.data.html }}",
        "additionalFields": {
          "bodyContentType": "html"
        }
      },
      "id": "outlook-send",
      "name": "Outlook Mail senden",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [480, 100],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "OUTLOOK_OAUTH_CREDENTIAL_ID",
          "name": "Microsoft Outlook account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true } }}",
        "options": {}
      },
      "id": "respond-sent",
      "name": "Antwort gesendet",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 100]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Testnachricht?", "type": "main", "index": 0 }]]
    },
    "Testnachricht?": {
      "main": [
        [{ "node": "Antwort Test", "type": "main", "index": 0 }],
        [{ "node": "Outlook Mail senden", "type": "main", "index": 0 }]
      ]
    },
    "Outlook Mail senden": {
      "main": [[{ "node": "Antwort gesendet", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "none" },
  "meta": { "templateCredsSetupCompleted": false },
  "tags": []
}
