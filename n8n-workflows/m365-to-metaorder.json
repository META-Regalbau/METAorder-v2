      "id": "an-metaorder-senden",
      "name": "An METAorder senden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2860,
        -200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "METAORDER_INTEGRATION_KEY_CREDENTIAL_ID",
          "name": "METAorder Integration-Key"
        }
      },
      "notes": "METAorder erkennt Bestellung / Angebot / Sonstiges, legt Entwürfe und bei Problemen Tickets an und sagt im Block „intake“, was mit der Mail passiert.",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 10000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// 2xx mit intake → erledigen; 409 läuft schon / 503 nicht bereit / 429 zu viele → nächster Lauf.\n// Sonst (METAorder-Fehler, nicht erreichbar) erst beim 3. Fehlversuch in Folge Problem melden.\nconst STRIKES = 3;\nconst store = $getWorkflowStaticData('global');\nstore.failures = store.failures || {};\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const ctx = $('Mail vorbereiten').itemMatching(i).json;\n  const key = ctx.message.id + ':upload';\n  const r = items[i].json || {};\n  const status = typeof r.statusCode === 'number' ? r.statusCode : null;\n  let body = r.body;\n  if (typeof body === 'string') {\n    try { body = JSON.parse(body); } catch (e) { body = {}; }\n  }\n  body = body && typeof body === 'object' ? body : {};\n  if (status === 409 || status === 503 || status === 429) continue;\n  if (status !== null && status >= 200 && status < 300) {\n    delete store.failures[key];\n    const intake = body.intake || { outcome: 'unknown', categories: [], forward: null, move: true, tickets: [] };\n    out.push({ json: { ...ctx, action: 'done', intake }, pairedItem: { item: i } });\n    continue;\n  }\n  const strikes = (store.failures[key] || 0) + 1;\n  store.failures[key] = strikes;\n  if (strikes < STRIKES) continue;\n  delete store.failures[key];\n  const errorText = body.error || (r.error && (r.error.message || String(r.error))) || 'METAorder nicht erreichbar';\n  out.push({ json: { ...ctx, action: 'report', stage: 'upload', statusCode: status, errorText }, pairedItem: { item: i } });\n}\nreturn out;\n"
      },
      "id": "ergebnis-auswerten",
      "name": "Ergebnis auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
