      "position": [
        1760,
        -100
      ],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "OUTLOOK_OAUTH_CREDENTIAL_ID",
          "name": "Microsoft Outlook account"
        }
      },
      "notes": "Alles, was noch im Posteingang liegt, ist offen: verarbeitete Mails wandern in den Zielordner. Älteste zuerst, ab dem Startdatum aus METAorder.",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Je Mail ein Eintrag; keine Mail → Lauf endet hier\nconst cfg = $('Ordner-ID').first().json;\nconst list = ($input.first().json.value) || [];\nreturn list.filter((m) => m && m.id).map((message) => ({ json: { cfg, message } }));\n"
      },
