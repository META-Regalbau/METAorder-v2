      },
      "id": "mail-holen-mime",
      "name": "Mail holen (MIME)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -100
      ],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "OUTLOOK_OAUTH_CREDENTIAL_ID",
          "name": "Microsoft Outlook account"
        }
      },
      "notes": "$value = komplette Mail mit Anhängen. Scheitert das dreimal, meldet der Workflow ein Problem an METAorder.",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Dateiname .eml + MIME message/rfc822 — sonst packt METAorder die Mail nicht aus.\n// Fehlt die Mail: erst beim 3. Fehlversuch in Folge Problem melden (vorübergehende Graph-Störung ≠ Ticket)\nconst STRIKES = 3;\nconst store = $getWorkflowStaticData('global');\nstore.failures = store.failures || {};\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const ctx = $('Mails einzeln').itemMatching(i).json;\n  const item = items[i];\n  const key = ctx.message.id + ':mime';\n  if (!item.binary || !item.binary.data) {\n    const strikes = (store.failures[key] || 0) + 1;\n    store.failures[key] = strikes;\n    if (strikes < STRIKES) continue; // liegen lassen, nächster Lauf versucht es erneut\n    delete store.failures[key];\n    const err = item.json && item.json.error;\n    out.push({\n      json: {\n        ...ctx,\n        ok: false,\n        stage: 'mime',\n        statusCode: null,\n        errorText: (err && (err.message || JSON.stringify(err))) || 'Graph lieferte die Mail nicht ($value)',\n      },\n      pairedItem: { item: i },\n    });\n    continue;\n  }\n  delete store.failures[key];\n  const binary = item.binary.data;\n  binary.mimeType = 'message/rfc822';\n  binary.fileName = 'outlook-' + String(ctx.message.id).slice(-32).replace(/[^A-Za-z0-9_-]/g, '_') + '.eml';\n  out.push({ json: { ...ctx, ok: true }, binary: { data: binary }, pairedItem: { item: i } });\n}\nreturn out;\n"
      },
      "id": "mail-vorbereiten",
      "name": "Mail vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        -100
      ]
    },
    {
