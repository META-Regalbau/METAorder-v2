    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Einstellungen').first().json.metaorderUrl }}/api/commercial-drafts/upload",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
