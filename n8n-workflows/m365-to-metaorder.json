      "id": "naechster-schritt",
      "name": "Nächster Schritt",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        3300,
        -200
      ],
      "notes": "Mails, die liegen bleiben (läuft schon, nicht bereit, erster/zweiter Fehlversuch), sind schon aussortiert.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Einstellungen').first().json.metaorderUrl }}/api/email-intake/problem",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ internetMessageId: $json.message.internetMessageId || null, graphMessageId: $json.message.id, subject: $json.message.subject || '', fromName: ($json.message.from && $json.message.from.emailAddress && $json.message.from.emailAddress.name) || null, fromAddress: ($json.message.from && $json.message.from.emailAddress && $json.message.from.emailAddress.address) || null, toAddresses: ($json.message.toRecipients || []).map(r => r.emailAddress && r.emailAddress.address).filter(Boolean), ccAddresses: ($json.message.ccRecipients || []).map(r => r.emailAddress && r.emailAddress.address).filter(Boolean), stage: $json.stage, statusCode: $json.statusCode, error: $json.errorText }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "problem-melden",
      "name": "Problem melden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3520,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "METAORDER_INTEGRATION_KEY_CREDENTIAL_ID",
          "name": "METAorder Integration-Key"
        }
      },
      "notes": "METAorder legt ein Ticket an (einmal je Mail) und weist es zu. Ist auch das nicht erreichbar, bleibt die Mail im Posteingang.",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Ticket angelegt → Mail erledigen (Kategorie Fehler, verschieben); sonst liegen lassen\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  // Ausgabe von „Problem melden“ ist nur die HTTP-Antwort: Mail-Kontext aus „Mail vorbereiten“\n  const ctx = $('Mail vorbereiten').itemMatching(i).json;\n  const r = items[i].json || {};\n  let body = r.body;\n  if (typeof body === 'string') {\n    try { body = JSON.parse(body); } catch (e) { body = {}; }\n  }\n  const ok = typeof r.statusCode === 'number' && r.statusCode >= 200 && r.statusCode < 300;\n  if (ok && body && body.intake) out.push({ json: { ...ctx, action: 'done', intake: body.intake } });\n}\nreturn out;\n"
      },
      "id": "meldung-auswerten",
      "name": "Meldung auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3740,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "Weiterleiten?",
              "leftValue": "={{ !!($json.intake && $json.intake.forward && $json.intake.forward.to) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "weiterleiten",
      "name": "Weiterleiten?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        3960,
        -200
      ],
      "notes": "Nur bei „Sonstiges“ und eingetragener Adresse.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.cfg.graphBase }}/messages/{{ $json.message.id }}/forward",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ comment: $json.intake.forward.comment, toRecipients: [{ emailAddress: { address: $json.intake.forward.to } }] }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "weiterleiten",
      "name": "Weiterleiten",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4180,
        -300
      ],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "OUTLOOK_OAUTH_CREDENTIAL_ID",
          "name": "Microsoft Outlook account"
        }
      },
      "notes": "Outlook leitet die Originalmail weiter, der Hinweis aus METAorder steht oben.",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// 202 = weitergeleitet. Gescheitert → Mail bleibt im Posteingang, nächster Lauf versucht es erneut\nconst out = [];\nconst items = $input.all();\nfor (let i = 0; i < items.length; i++) {\n  const r = items[i].json || {};\n  const ok = typeof r.statusCode === 'number' ? r.statusCode >= 200 && r.statusCode < 300 : !r.error;\n  if (ok) out.push({ json: $('Weiterleiten?').itemMatching(i).json });\n}\nreturn out;\n"
      },
      "id": "weiterleitung-pruefen",
      "name": "Weiterleitung prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4400,
        -300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Vorhandene Kategorien behalten, die von METAorder dazu\nconst ctx = $input.item.json;\nconst current = Array.isArray(ctx.message.categories) ? ctx.message.categories : [];\nconst add = (ctx.intake && Array.isArray(ctx.intake.categories)) ? ctx.intake.categories : [];\nconst categories = [...new Set([...current, ...add])];\nreturn { json: { ...ctx, patchBody: { categories } } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "kategorien-vorbereiten",
      "name": "Kategorien vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4620,
        -200
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $json.cfg.graphBase }}/messages/{{ $json.message.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
