      "parameters": {
        "jsCode": "// Antwort von „suchen“ (value[]) oder „anlegen“ (Ordner direkt)\nconst cfg = $('METAorder: Konfiguration').first().json;\nconst j = $input.first().json;\nconst folderId = Array.isArray(j.value) ? (j.value[0] && j.value[0].id) : j.id;\nif (!folderId) {\n  throw new Error('Zielordner „' + cfg.processedFolderName + '“ weder gefunden noch angelegt');\n}\nreturn [{ json: { ...cfg, folderId } }];\n"
      },
